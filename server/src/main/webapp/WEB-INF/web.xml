<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Waste collection requests</display-name>

    <servlet>
        <servlet-name>ContainerSiteServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.ContainerSiteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ContainerSiteServlet</servlet-name>
        <url-pattern>/sites</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PickupRequestServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.PickupRequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PickupRequestServlet</servlet-name>
        <url-pattern>/requests</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VehicleServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.VehicleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VehicleServlet</servlet-name>
        <url-pattern>/vehicles</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TripServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.TripServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TripServlet</servlet-name>
        <url-pattern>/trips</url-pattern>
    </servlet-mapping>
</web-app>
